{
  "fields": {
    "title":      { "type": "string", "from": "header:title" },
    "type":       { "type": "enum", "values": ["prd", "spec", "design", "tdd", "issue", "map", "doc"] },
    "status":     { "type": "enum", "values": ["draft", "review", "approved", "implemented", "rejected"], "from": "header:status" },
    "date":       { "type": "date", "from": "header:date" },
    "owner":      { "type": "string" },
    "area":       { "type": "list" },
    "blocked-by": { "type": "path", "repeatable": true }
  },
  "infer": [
    { "match": "/issues/", "set": { "type": "issue" } },
    { "match": "/tdds/", "set": { "type": "tdd" } },
    { "match": "/prd-[^/]*\\.html$", "set": { "type": "prd" } }
  ],
  "defaults": { "type": "doc" },
  "rankings": {}
}
